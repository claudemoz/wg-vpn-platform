# Server
APP_ENV=development
APP_PORT=8080

# Database (PostgreSQL)
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=wg-vpn-platform
DB_SSLMODE=disable
DB_TIMEZONE=UTC

# JWT
JWT_SECRET=change_me_in_production
JWT_EXPIRATION_HOURS=2160

# WireGuard
WG_DEFAULT_SUBNET=10.8.0.0/24
WG_DNS=1.1.1.1,8.8.8.8
WG_ALLOWED_IPS=0.0.0.0/0,::/0
WG_KEEPALIVE=25
